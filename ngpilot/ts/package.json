{
  "name": "@orektic/ngpilot",
  "version": "1.0.0",
  "description": "A multi-repository Angular code discovery, refactoring and automation toolkit.",
  "bin": {
    "ngpilot": "./dist/angular_io_tool.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/angular_io_tool.js",
    "ngpilot": "node dist/angular_io_tool.js",
    "test": "npm run build && node scripts/test-local-commit.js",
    "test:commit": "npm run test"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enzigma-darsh-shah/developer_tools.git"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^18.19.0",
    "typescript": "^5.3.3"
  }
}
